  <rdfs:comment xml:lang="en">Mean amplitude change in the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">mean_amplitude_change</rdfs:label>
  <rdfs:label xml:lang="es">mean_amplitude_change</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#median">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Median of the EEG signal.</rdfs:comment>
  <rdfs:comment xml:lang="es">Mediana de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">median</rdfs:label>
  <rdfs:label xml:lang="es">median</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#onsetDelayInMonths">
  <rdfs:subPropertyOf rdf:resource="#SymptomProperty"/>
  <rdfs:domain rdf:resource="#Symptom"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="es">Especifica la cantidad de meses entre el evento traumático y la presencia de los síntomas. Tanto DSM5 como CIE11 los consideran en el TEPT cuando los síntomas aparecen después de 6 o más meses despues del evento.</rdfs:comment>
  <rdfs:label xml:lang="en">Specifies the delay in months between the traumatic event and the onset of the symptom. Both DSM-5 and ICD-11 allow for delayed-onset PTSD when symptoms appear six or more months after the event.</rdfs:label>
  <rdfs:label xml:lang="es">mesesLatenciaInicio</rdfs:label>
  <rdfs:label xml:lang="en">onsetDelayInMonths</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#rhythm">
  <rdfs:subPropertyOf rdf:resource="#EEGProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment xml:lang="es">Definición de rhythm</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of rhythm</rdfs:comment>
  <rdfs:label xml:lang="en">eeg_rhythm</rdfs:label>
  <rdfs:label xml:lang="es">rítmo_eeg</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#rootMeanSquare">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
