          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#AvoidanceSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#duration"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#IntrusionSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#duration"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ThreatArousalSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#duration"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionDSM"/>
      <owl:someValuesFrom rdf:resource="#DSM5_CriterionF_SymptomsDuration"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets DSM-5 Criterion F, indicating that the disturbance (symptoms in Criteria B, C, D, and E) lasts for more than one month.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio F del DSM-5, indicando que la alteración (síntomas de los Criterios B, C, D y E) persiste por más de un mes.</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleDSM5_F</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsDSM5_F</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsDSM5_G">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#AffectiveCognitiveAlteration"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#disturbanceClinicallySignificant"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#AvoidanceSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#disturbanceClinicallySignificant"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#IntrusionSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#disturbanceClinicallySignificant"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ThreatArousalSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#disturbanceClinicallySignificant"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionDSM"/>
      <owl:someValuesFrom rdf:resource="#DSM5_CriterionG_DisturbanceSignificant"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets DSM-5 Criterion G, indicating that the disturbance causes clinically significant distress or impairment in social, occupational, or other important areas of functioning.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio G del DSM-5, indicando que la alteración causa malestar clínicamente significativo o deterioro en el funcionamiento social, laboral u otras áreas importantes.</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleDSM5_G</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsDSM5_G</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsDSM5_H">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
