  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Asimetría directa de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Direct asymmetry of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">signal_asymmetry</rdfs:label>
  <rdfs:label xml:lang="es">signal_asymmetry</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#signalKurtosis">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Curtosis directa de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Direct kurtosis of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">signal_kurtosis</rdfs:label>
  <rdfs:label xml:lang="es">signal_kurtosis</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#squaredIntegral">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Integral del cuadrado de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Squared integral of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">squared_integral</rdfs:label>
  <rdfs:label xml:lang="es">squared_integral</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#standardDeviation">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Desviación estándar de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Standard deviation of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">standard_deviation</rdfs:label>
