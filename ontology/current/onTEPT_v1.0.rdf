              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#AffectiveCognitiveAlteration"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#attributableEffectsSubstance"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
