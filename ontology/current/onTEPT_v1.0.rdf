  <rdfs:comment xml:lang="en">Root mean square of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">root_mean_square</rdfs:label>
  <rdfs:label xml:lang="es">root_mean_square</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#segment">
  <rdfs:subPropertyOf rdf:resource="#EEGProperty"/>
  <rdfs:comment xml:lang="es">Definición de segment</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of segment</rdfs:comment>
  <rdfs:label xml:lang="en">segment</rdfs:label>
  <rdfs:label xml:lang="es">segmento</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#shannonEntropy">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Entropía de Shannon aplicada a la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Shannon entropy applied to the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">shannon_entropy</rdfs:label>
  <rdfs:label xml:lang="es">shannon_entropy</rdfs:label>
</owl:DatatypeProperty>

