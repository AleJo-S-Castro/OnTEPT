  <rdfs:comment xml:lang="es">Valor medio de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">mean</rdfs:label>
  <rdfs:label xml:lang="es">mean</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#meanAmplitudeChange">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
