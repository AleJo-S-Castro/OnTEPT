    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets DSM-5 Criterion H, indicating that the disturbance is not attributable to the physiological effects of a substance or another medical condition.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio H del DSM-5, indicando que la alteración no se debe a los efectos fisiológicos de una sustancia ni a otra condición médica.</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleDSM5_H</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsDSM5_H</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsDSM5_XDissociative">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSymptom"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#DepersonalizationSymptom"/>
            <rdf:Description rdf:about="#DerealizationSymptom"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionDSM"/>
      <owl:someValuesFrom rdf:resource="#DSM5_CriterionX_Dissociative"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets the DSM-5 criteria for dissociative symptoms, qualifying for the dissociative subtype of PTSD, characterized by persistent or recurrent symptoms of depersonalization or derealization.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple los criterios del DSM-5 para síntomas disociativos, calificando para el subtipo disociativo del TEPT, caracterizado por síntomas persistentes o recurrentes de despersonalización o desrealización.</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleDSM5_XDisociativo</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsDSM5_XDissociative</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsICD11_1">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEvent"/>
      <owl:someValuesFrom rdf:resource="#TraumaticEvent"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionICD"/>
      <owl:someValuesFrom rdf:resource="#ICD11_Criterion1_Exposure"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets ICD-11 Criterion 1, indicating exposure to an extremely threatening or horrific event or series of events.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio 1 del ICD-11, indicando exposición a un evento o serie de eventos extremadamente amenazantes u horribles.</rdfs:comment>
  <rdfs:label xml:lang="es">paciente_cumpleicd11_1</rdfs:label>
  <rdfs:label xml:lang="en">patient_meetsicd11_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsICD11_2">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSymptom"/>
      <owl:someValuesFrom rdf:resource="#IntrusionSymptom"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionICD"/>
      <owl:someValuesFrom rdf:resource="#ICD11_Criterion2_IntrusionSymptom"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets ICD-11 Criterion 2 by exhibiting re-experiencing of the traumatic event in the present, in the form of vivid intrusive memories, flashbacks, or nightmares, accompanied by intense fear or horror.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio 2 del ICD-11 al presentar reexperimentación del evento traumático en el presente, en forma de recuerdos intrusivos vívidos, flashbacks o pesadillas, acompañados de miedo o terror intensos.</rdfs:comment>
  <rdfs:label xml:lang="es">paciente_cumpleicd11_2</rdfs:label>
  <rdfs:label xml:lang="en">patient_meetsicd11_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsICD11_3">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSymptom"/>
      <owl:someValuesFrom rdf:resource="#AvoidanceSymptom"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionICD"/>
      <owl:someValuesFrom rdf:resource="#ICD11_Criterion3_AvoidanceSymptom"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets ICD-11 Criterion 3 by showing avoidance of thoughts and memories of the event, or avoidance of activities, situations, or people reminiscent of it.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio 3 del ICD-11 al mostrar evitación de pensamientos y recuerdos del evento, o evitación de actividades, situaciones o personas que lo recuerdan.</rdfs:comment>
  <rdfs:label xml:lang="es">paciente_cumpleicd11_3</rdfs:label>
  <rdfs:label xml:lang="en">patient_meetsicd11_3</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsICD11_4">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSymptom"/>
      <owl:someValuesFrom rdf:resource="#ThreatArousalSymptom"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionICD"/>
      <owl:someValuesFrom rdf:resource="#ICD11_Criterion4_ThreatArousalSymptom"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets ICD-11 Criterion 4, showing a persistent sense of current threat manifested by hypervigilance or an exaggerated startle response.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio 4 del ICD-11, mostrando una sensación persistente de amenaza actual manifestada por hipervigilancia o una respuesta de sobresalto exagerada.</rdfs:comment>
  <rdfs:label xml:lang="es">paciente_cumpleicd11_4</rdfs:label>
  <rdfs:label xml:lang="en">patient_meetsicd11_4</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsICD11_5">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#AvoidanceSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#duration"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#IntrusionSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#duration"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ThreatArousalSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#duration"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionICD"/>
      <owl:someValuesFrom rdf:resource="#ICD11_Criterion5_SymptomsDuration"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets ICD-11 Criterion 5, indicating that the symptoms cause significant impairment in personal, family, social, educational, occupational, or other important areas of functioning.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio 5 del ICD-11, indicando que los síntomas provocan un deterioro significativo en el funcionamiento personal, familiar, social, educativo, laboral u otras áreas importantes.</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleICD11_5</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsICD11_5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsICD11_6">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#AvoidanceSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#disturbanceClinicallySignificant"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#IntrusionSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#disturbanceClinicallySignificant"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ThreatArousalSymptom"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#disturbanceClinicallySignificant"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionICD"/>
      <owl:someValuesFrom rdf:resource="#ICD11_Criterion6_DisturbanceSignificant"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets ICD-11 Criterion 6, indicating that the symptoms are not attributable to the physiological effects of substances or other medical conditions and are not better explained by another mental disorder.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple el Criterio 6 del ICD-11, indicando que los síntomas no se deben a efectos fisiológicos de sustancias u otras condiciones médicas, ni se explican mejor por otro trastorno mental.</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleICD11_6</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsICD11_6</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsICD11_XComplex">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom rdf:resource="#AffectDysregulation"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom rdf:resource="#NegativeSelfConcept"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSymptom"/>
          <owl:someValuesFrom rdf:resource="#RelationalDisturbance"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#meetsCriterionICD"/>
      <owl:someValuesFrom rdf:resource="#ICD11_Criterion_Complex"/>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="en">A patient who meets the DSM-5 criteria for dissociative symptoms, qualifying for the dissociative subtype of PTSD, characterized by persistent or recurrent symptoms of depersonalization or derealization.</rdfs:comment>
  <rdfs:comment xml:lang="es">Paciente que cumple los criterios del DSM-5 para síntomas disociativos, calificando para el subtipo disociativo del TEPT, caracterizado por síntomas persistentes o recurrentes de despersonalización o desrealización.</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleCIE5_XComplejo</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsICD5_XComplex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RelationalDisturbance">
  <rdfs:subClassOf rdf:resource="#SelfOrganizationDisturbance"/>
  <rdfs:label xml:lang="es">Dificultades persistentes para mantener relaciones y sentirse cercano a los demás.</rdfs:label>
  <rdfs:label xml:lang="en">Persistent difficulties in sustaining relationships and feeling close to others.</rdfs:label>
  <rdfs:label xml:lang="es">dificultadesRelacionales</rdfs:label>
  <rdfs:label xml:lang="en">relationalDisturbance</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsPTSD_Complex_ICD11">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_1"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_2"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_3"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_4"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_5"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_6"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_XComplex"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:disjointWith rdf:resource="#Patient_meetsPTSD_ICD11"/>
  <rdfs:comment xml:lang="es">
		Representa a un paciente que cumple todos los requisitos diagnósticos para el Trastorno de Estrés Postraumático Complejo (TEPT-C) según la CIE-11. 
		Esta clase de equivalencia incluye los síntomas nucleares del TEPT (ICD11_1–ICD11_6) más alteraciones en la autorregulación emocional, el autoconcepto y las relaciones interpersonales.
	  </rdfs:comment>
  <rdfs:comment xml:lang="en">
		Represents a patient who meets all diagnostic requirements for Complex Post-Traumatic Stress Disorder (CPTSD) according to ICD-11. 
		This equivalence class includes PTSD core symptoms (ICD11_1–ICD11_6) plus disturbances in self-organization (affect regulation, self-concept, and relational difficulties).
	  </rdfs:comment>
  <rdfs:label xml:lang="es">paciente_cumple_tept_complejo_cie11</rdfs:label>
  <rdfs:label xml:lang="en">patient_meets_ptsd_complex_icd11</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsPTSD_ICD11">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_1"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_2"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_3"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_4"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_5"/>
        <rdf:Description rdf:about="#Patient_meetsICD11_6"/>
        <owl:Class>
          <owl:complementOf rdf:resource="#Patient_meetsICD11_XComplex"/>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="es">
		Representa a un paciente que cumple todos los requisitos diagnósticos para el Trastorno de Estrés Postraumático (TEPT) según la clasificación CIE-11. 
		Esta clase de equivalencia se define como un paciente que cumple los criterios ICD11_1 a ICD11_6, y que no cumple los criterios del subtipo disociativo.
		(Patient and Patient_meetsICD11_1 and Patient_meetsICD11_2 and Patient_meetsICD11_3 and Patient_meetsICD11_4 and Patient_meetsICD11_5 and Patient_meetsICD11_6 and not Patient_meetsICD11_Dissociative).
	  </rdfs:comment>
  <rdfs:comment xml:lang="en">
		Represents a patient who meets all diagnostic requirements for Post-Traumatic Stress Disorder (PTSD) according to the ICD-11 classification system. 
		This equivalence class is defined as a patient who satisfies criteria ICD11_1 through ICD11_6, and does not meet the criteria for the dissociative subtype.
		(Patient and Patient_meetsICD11_1 and Patient_meetsICD11_2 and Patient_meetsICD11_3 and Patient_meetsICD11_4 and Patient_meetsICD11_5 and Patient_meetsICD11_6 and not Patient_meetsICD11_Dissociative).
	  </rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleTEPT_CIE11</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsPTSD_ICD11</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsPTSD_DSM5">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_A"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_B"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_C"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_D"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_E"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_F"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_G"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_H"/>
        <owl:Class>
          <owl:complementOf rdf:resource="#Patient_meetsDSM5_XDissociative"/>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:subClassOf rdf:resource="#Patient_meetsPTSD_ICD11"/>
  <owl:disjointWith rdf:resource="#Patient_meetsPTSD_WithDissociative_DSM5"/>
  <rdfs:comment xml:lang="es">Axioma de interoperabilidad formal añadido en v1.3: Patient_meetsPTSD_DSM5 SubClassOf Patient_meetsPTSD_ICD11. Todo paciente que satisface los criterios DSM-5 A-H (sin subtipo disociativo) también satisface los criterios CIE-11 1-6, dado que el conjunto DSM-5 subsume al conjunto CIE-11. La inversa no se cumple: el TEPT CIE-11 no requiere el Criterio D (alteraciones cognitivas y del ánimo), por lo que TEPT CIE-11 ⊄ TEPT DSM-5.</rdfs:comment>
  <rdfs:comment xml:lang="en">Formal interoperability axiom added in v1.3: Patient_meetsPTSD_DSM5 SubClassOf Patient_meetsPTSD_ICD11. Any patient satisfying all DSM-5 criteria (A-H, without dissociative subtype) is entailed to also satisfy ICD-11 criteria 1-6, since the DSM-5 criterion set subsumes the ICD-11 set. The converse does not hold: ICD-11 PTSD does not require Criterion D (cognitive-mood alterations), so ICD-11 PTSD ⊄ DSM-5 PTSD.</rdfs:comment>
  <rdfs:comment xml:lang="es">Representa a un paciente que cumple todos los criterios diagnósticos para el Trastorno de Estrés Postraumático (TEPT) según el DSM-5. La clase de equivalencia incluye la presencia de los criterios A a H (exposición, intrusión, evitación, alteraciones cognitivas y del estado de ánimo, hiperactivación, duración, malestar o deterioro funcional y exclusión), excluyendo el subtipo disociativo.

(Patient and Patient_meetsDSM5_A and Patient_meetsDSM5_B and Patient_meetsDSM5_C and Patient_meetsDSM5_D and Patient_meetsDSM5_E and Patient_meetsDSM5_F and Patient_meetsDSM5_G and Patient_meetsDSM5_H and not Patient_meetsDSM5_Dissociative).</rdfs:comment>
  <rdfs:comment xml:lang="en">Represents a patient who fulfills all diagnostic criteria for Post-Traumatic Stress Disorder (PTSD) according to the DSM-5 classification. The equivalence class includes the presence of criteria A through H (exposure, intrusion, avoidance, alterations in cognition and mood, hyperarousal, duration, distress/impairment, and exclusion), excluding the dissociative subtype. 

(Patient and Patient_meetsDSM5_A and Patient_meetsDSM5_B and Patient_meetsDSM5_C and Patient_meetsDSM5_D and Patient_meetsDSM5_E and Patient_meetsDSM5_F and Patient_meetsDSM5_G and Patient_meetsDSM5_H and not Patient_meetsDSM5_Dissociative).</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleTEPT_DSM5</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsPTSD_DSM5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_meetsPTSD_WithDissociative_DSM5">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_A"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_B"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_C"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_D"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_E"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_F"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_G"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_H"/>
        <rdf:Description rdf:about="#Patient_meetsDSM5_XDissociative"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="es">
		Representa a un paciente que cumple los criterios diagnósticos del TEPT según el DSM-5 y que además presenta el subtipo disociativo, 
		caracterizado por síntomas persistentes o recurrentes de despersonalización y/o desrealización.
	  </rdfs:comment>
  <rdfs:comment xml:lang="en">
		Represents a patient who meets the DSM-5 diagnostic criteria for PTSD and additionally presents the dissociative subtype, 
		characterized by persistent or recurrent symptoms of depersonalization and/or derealization.
	  </rdfs:comment>
  <rdfs:label xml:lang="es">Paciente_cumpleTEPT_conDisociación_DSM5</rdfs:label>
  <rdfs:label xml:lang="en">Patient_meetsPTSD_WithDissociative_DSM5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Patient_probablyMeets_PTSD_byAssesmentInstrument">
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#isAssessedBy"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#PTSD_Checklist_PCL5"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#PCL_totalScore"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">31</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#PrimaryCarePTSD_Screen_PC-PTSD-5"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#PC-PTSD_ItemtotalScore"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#CAPS_totalScore"/>
                  <owl:someValuesFrom>
                    <rdfs:Datatype>
                      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                      <owl:withRestrictions>
                        <rdf:Description>
                          <rdf:first>
                            <rdf:Description>
                              <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">31</xsd:minInclusive>
                            </rdf:Description>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </owl:withRestrictions>
                    </rdfs:Datatype>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="es">Paciente que, según un instrumento psicométrico, probablemente cumple criterios de TEPT. Actualizado en v1.3: (a) umbral PCL-5 ajustado a ≥31 (sensibilidad ~0.88, especificidad ~0.87; Weathers et al. 2013); (b) rama CAPS-5 añadida (puntaje total ítems 1-20 ≥31); (c) rama PCL-C eliminada — PCL-C mapea a DSM-IV, no a DSM-5, y sus ítems no están alineados con los subcriterios DSM-5. Equivalencia: isAssessedBy some ((PTSD_Checklist_PCL5 ∩ PCL_totalScore≥31) ∪ (CAPS-5 ∩ CAPS_totalScore≥31) ∪ (PC-PTSD-5 ∩ PC-PTSD_ItemtotalScore≥3)).</rdfs:comment>
  <rdfs:comment xml:lang="en">Patient who, according to a psychometric assessment instrument, probably meets PTSD criteria. Updated in v1.3: (a) PCL-5 threshold adjusted to ≥31 (sensitivity ~0.88, specificity ~0.87; Weathers et al. 2013); (b) CAPS-5 branch added (total score items 1-20 ≥31); (c) PCL-C branch removed — PCL-C maps to DSM-IV, not DSM-5, and its items are not aligned with current DSM-5 sub-criteria. Equivalence: isAssessedBy some ((PTSD_Checklist_PCL5 ∩ PCL_totalScore≥31) ∪ (CAPS-5 ∩ CAPS_totalScore≥31) ∪ (PC-PTSD-5 ∩ PC-PTSD_ItemtotalScore≥3)).</rdfs:comment>
  <rdfs:label xml:lang="es">Paciente probablemente cumple con TEPT según instrumento de evaluación</rdfs:label>
  <rdfs:label xml:lang="en">Patient probably meets PTSD by Assessment Instrument</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Evaluación_Global_de_Estrés_Postraumático_(EGEP-5)">
  <rdfs:subClassOf rdf:resource="#Self-ReportInstrument"/>
  <rdfs:comment xml:lang="es">Autoinforme para evaluación de la sintomatología y diagnóstico del trastorno por estrés postrumático (TEPT) según los criterios del DSM-5 en víctimas adultas (mayores de 18 años) de distintos acontecimientos traumáticos</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of Evaluación_Global_de_Estrés_Postraumático_(EGEP-5)</rdfs:comment>
  <rdfs:label xml:lang="en">egep-5</rdfs:label>
  <rdfs:label xml:lang="es">egep-5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Mini_International_Neuropsychiatric_Interview_(MINI)">
  <rdfs:subClassOf rdf:resource="#ClinicianAdministeredInstrument"/>
  <rdfs:comment xml:lang="es">Definición de Mini_International_Neuropsychiatric_Interview_(MINI)</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of Mini_International_Neuropsychiatric_Interview_(MINI)</rdfs:comment>
  <rdfs:label xml:lang="en">mini_international_neuropsychiatric_interview_(mini)</rdfs:label>
  <rdfs:label xml:lang="es">mini_international_neuropsychiatric_interview_(mini)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Screen_for_Posttraumatic_Stress_Symptoms_(SPTSS)">
  <rdfs:subClassOf rdf:resource="#ScreeningInstrument"/>
  <rdfs:comment xml:lang="en">Definition of Screen_for_Posttraumatic_Stress_Symptoms_(SPTSS)</rdfs:comment>
  <rdfs:comment xml:lang="es">Evaluación inicial de síntomas postraumáticos</rdfs:comment>
  <rdfs:label xml:lang="en">screen_for_posttraumatic_stress_symptoms_(sptss)</rdfs:label>
  <rdfs:label xml:lang="es">screen_for_posttraumatic_stress_symptoms_(sptss)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Structured_Clinical_Interview_for_DSM_Disorders_(SCID-5)">
  <rdfs:subClassOf rdf:resource="#ClinicianAdministeredInstrument"/>
  <rdfs:comment xml:lang="es">Definición de Structured_Clinical_Interview_for_DSM_Disorders_(SCID-5)</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of Structured_Clinical_Interview_for_DSM_Disorders_(SCID-5)</rdfs:comment>
  <rdfs:label xml:lang="en">structured_clinical_interview_for_dsm_disorders_(scid-5)</rdfs:label>
  <rdfs:label xml:lang="es">structured_clinical_interview_for_dsm_disorders_(scid-5)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Trauma_Screening_Questionnaire_(TSQ)">
  <rdfs:subClassOf rdf:resource="#ScreeningInstrument"/>
  <rdfs:comment xml:lang="es">Cuestionario de 10 ítems para tamizaje en población general</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of Trauma_Screening_Questionnaire_(TSQ)</rdfs:comment>
  <rdfs:label xml:lang="en">trauma_screening_questionnaire_(tsq)</rdfs:label>
  <rdfs:label xml:lang="es">trauma_screening_questionnaire_(tsq)</rdfs:label>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#A4_EEG_rhythm"/>
    <rdf:Description rdf:about="#D1_EEG_rhythm"/>
    <rdf:Description rdf:about="#D2_EEG_rhythm"/>
    <rdf:Description rdf:about="#D3_EEG_rhythm"/>
    <rdf:Description rdf:about="#D4_EEG_rhythm"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#AffectiveCognitiveAlteration"/>
    <rdf:Description rdf:about="#AvoidanceSymptom"/>
    <rdf:Description rdf:about="#IntrusionSymptom"/>
    <rdf:Description rdf:about="#ThreatArousalSymptom"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#PTSD_Classic"/>
    <rdf:Description rdf:about="#PTSD_Complex"/>
    <rdf:Description rdf:about="#PTSD_withDissociativeSymptom"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
