<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/alejo/ontologies/2025/0/OnTEPT"
         xmlns="http://www.semanticweb.org/alejo/ontologies/2025/0/OnTEPT#">

<owl:Ontology rdf:about="http://www.semanticweb.org/alejo/ontologies/2025/0/OnTEPT">
  <owl:versionIRI rdf:resource="http://www.semanticweb.org/alejo/ontologies/2025/0/OnTEPT/1.1"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OnTEPT es una ontología OWL 2 DL multimodal para la identificación y clasificación del Trastorno de Estrés Postraumático (TEPT). Su dominio cubre cuatro áreas integradas: criterios diagnósticos formales (DSM-5 y CIE-11), instrumentos de evaluación psicométrica (PCL-C, PCL-5, PC-PTSD-5 y otros), datos electrofisiológicos (señales EEG con más de 20 características extraídas), y clasificación clínica automática de pacientes mediante razonamiento ontológico. La ontología define equivalencias para cuatro fenotipos de paciente: TEPT clásico DSM-5, TEPT con subtipo disociativo DSM-5, TEPT clásico CIE-11 y TEPT complejo CIE-11, con reglas que permiten probar la interoperabilidad asimétrica entre los dos sistemas de clasificación. Está diseñada para ser bilingüe (español/inglés) y está alineada parcialmente con el vocabulario MESH.</rdfs:label>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V1.0</owl:versionInfo>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#assesses">
  <owl:inverseOf rdf:resource="#isAssessedBy"/>
  <rdfs:domain rdf:resource="#PsychometricAssessmentInstrument"/>
  <rdfs:range rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="es">Relaciona un instrumento de evaluación con un paciente al que evalúa.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates an assessment instrument with a patient it assesses.</rdfs:comment>
  <rdfs:label xml:lang="en">assesses</rdfs:label>
  <rdfs:label xml:lang="es">evalúa</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAssessedBy">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#PsychometricAssessmentInstrument"/>
  <rdfs:comment xml:lang="es">Relaciona a un paciente con el instrumento utilizado para evaluarlo</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a patient to the instrument used to assess them</rdfs:comment>
  <rdfs:label xml:lang="es">es_evaluado_por</rdfs:label>
  <rdfs:label xml:lang="en">is_assessed_by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasComplexSymptom">
  <rdfs:subPropertyOf rdf:resource="#hasSymptom"/>
  <owl:inverseOf rdf:resource="#isComplexSymptomOf"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#SelfOrganizationDisturbance"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSymptom">
  <owl:inverseOf rdf:resource="#isSymptomOfA"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Symptom"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment xml:lang="es">Relaciona a un paciente con los síntomas que experimenta</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a patient to the symptoms they experience</rdfs:comment>
  <rdfs:label xml:lang="en">has_symptom</rdfs:label>
  <rdfs:label xml:lang="es">tiene_sintoma</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isComplexSymptomOf">
  <rdfs:subPropertyOf rdf:resource="#isSymptomOfA"/>
  <rdfs:domain rdf:resource="#SelfOrganizationDisturbance"/>
  <rdfs:range rdf:resource="#Patient"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isSymptomOfA">
  <rdfs:domain rdf:resource="#Symptom"/>
  <rdfs:range rdf:resource="#Patient"/>
  <rdfs:comment xml:lang="es">Relaciona a un síntoma con un paciente.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a symptom with a patient</rdfs:comment>
  <rdfs:label xml:lang="es">es_síntoma_de_un</rdfs:label>
  <rdfs:label xml:lang="en">is_symptom_of_a</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDissociativeSymptom">
  <rdfs:subPropertyOf rdf:resource="#hasSymptom"/>
  <owl:inverseOf rdf:resource="#isDissociativeSymptomOf"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#DepersonalizationSymptom"/>
  <rdfs:range rdf:resource="#DerealizationSymptom"/>
  <rdfs:range rdf:resource="#DissociativeSymptom"/>
  <rdfs:comment xml:lang="es">Relaciona a un paciente con un síntoma disociativo que experimenta.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a patient with a dissociative symptom they experience.</rdfs:comment>
  <rdfs:label xml:lang="en">has_dissociative_symptom</rdfs:label>
  <rdfs:label xml:lang="es">tiene_síntoma_disociativo</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isDissociativeSymptomOf">
  <rdfs:subPropertyOf rdf:resource="#isSymptomOfA"/>
  <rdfs:domain rdf:resource="#DissociativeSymptom"/>
  <rdfs:range rdf:resource="#Patient"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasEEGRecording">
  <owl:inverseOf rdf:resource="#recordsActivityOf"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#EEG_Recording"/>
  <rdfs:comment xml:lang="es">Relaciona a un paciente con un registro EEG</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a patient with a EEG Recording</rdfs:comment>
  <rdfs:label xml:lang="en">has_eeg_recording</rdfs:label>
  <rdfs:label xml:lang="es">tiene_eeg</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recordsActivityOf">
  <rdfs:domain rdf:resource="#EEG_Recording"/>
  <rdfs:range rdf:resource="#Person"/>
  <rdfs:comment xml:lang="es">Relaciona un registro EEG con la persona cuya actividad cerebral ha sido registrada.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates an EEG recording with the person whose brain activity has been recorded.</rdfs:comment>
  <rdfs:label xml:lang="en">records_activity</rdfs:label>
  <rdfs:label xml:lang="es">registra_actividad</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasEvent">
  <owl:inverseOf rdf:resource="#isExperiencedBy"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Event"/>
  <rdfs:comment xml:lang="es">Relaciona a un paciente con un evento</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a patient with an event</rdfs:comment>
  <rdfs:label xml:lang="en">has_event</rdfs:label>
  <rdfs:label xml:lang="es">tiene_evento</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isExperiencedBy">
  <rdfs:domain rdf:resource="#Event"/>
  <rdfs:range rdf:resource="#Person"/>
  <rdfs:comment xml:lang="es">Relaciona un evento traumático con la persona que lo ha experimentado.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a traumatic event with the person who has experienced it.</rdfs:comment>
  <rdfs:label xml:lang="es">es_experimentado_por</rdfs:label>
  <rdfs:label xml:lang="en">is_experienced_by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTraumaticEvent">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#TraumaticEvent"/>
  <rdfs:comment xml:lang="es">Relaciona a una persona con un evento traumático que ha experimentado.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a person with a traumatic event they have experienced.</rdfs:comment>
  <rdfs:label xml:lang="en">has_traumatic_event</rdfs:label>
  <rdfs:label xml:lang="es">tiene_evento_traumático</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isASymptomOf">
  <rdfs:domain rdf:resource="#Symptom"/>
  <rdfs:range rdf:resource="#PTSD_subtype"/>
  <rdfs:comment xml:lang="es">Relaciona un síntoma con el trastorno de estrés postraumático del cual es manifestación.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a symptom with the PTSD condition it is a manifestation of.</rdfs:comment>
  <rdfs:label xml:lang="es">es_sintoma_de</rdfs:label>
  <rdfs:label xml:lang="en">is_a_symptom_of</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#meetsCriterionDSM">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#PTSD_DSM_5_DiagnosticCriterion"/>
  <rdfs:comment xml:lang="es">Relaciona a un paciente con el criterio diagnóstico del DSM-5 que cumple.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a patient with the DSM-5 diagnostic criterion they meet</rdfs:comment>
  <rdfs:label xml:lang="es">cumple_criterio_dsm</rdfs:label>
  <rdfs:label xml:lang="en">meets_criterion_dsm</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#meetsCriterionICD">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#PTSD_ICD_11_DiagnosticCriterion"/>
  <rdfs:comment xml:lang="es">Relaciona a un paciente con el criterio diagnóstico del CIE-11 que cumple.</rdfs:comment>
  <rdfs:comment xml:lang="en">Relates a patient with the ICD-11 diagnostic criterion they meet</rdfs:comment>
  <rdfs:label xml:lang="es">cumple_criterio_cie</rdfs:label>
  <rdfs:label xml:lang="en">meets_criterion_icd</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#meetsDiagnosis">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#TraumaAndStressorRelatedDisorders"/>
  <rdfs:comment xml:lang="en">Associate a patient with a diagnosis</rdfs:comment>
  <rdfs:comment xml:lang="es">Relaciona un paciente con un diagnóstico</rdfs:comment>
  <rdfs:label xml:lang="es">cumple_diagnostico</rdfs:label>
  <rdfs:label xml:lang="en">meets_diagnosis</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#CAPSProperty">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">Parent property for all CAPS-5 (Clinician-Administered PTSD Scale for DSM-5) item responses. Each item is scored 0-4: 0=absent, 1=mild/subthreshold, 2=moderate/threshold, 3=severe, 4=extreme/incapacitating.</rdfs:comment>
  <rdfs:comment xml:lang="es">Propiedad padre de todos los ítems de la CAPS-5 (Clinician-Administered PTSD Scale para DSM-5). Cada ítem se puntúa 0-4: 0=ausente, 1=leve/subumbral, 2=moderado/umbral, 3=severo, 4=extremo/incapacitante.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_property</rdfs:label>
  <rdfs:label xml:lang="es">propiedad_caps</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item1">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB1:IntrusiveMemories"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 1 – Criterion B1: Recurrent, involuntary, intrusive distressing memories. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 1 – Criterio B1: Recuerdos angustiosos recurrentes, involuntarios e intrusivos. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_1</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_1</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item10">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD3:DistortedCognitionsAboutCause"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 10 – Criterion D3: Persistent, distorted blame of self or others. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 10 – Criterio D3: Culpa persistente y distorsionada hacia uno mismo u otros. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_10</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_10</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item11">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD4:PersistentNegativeEmotions"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 11 – Criterion D4: Persistent negative emotional state (fear, horror, anger, guilt, shame). Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 11 – Criterio D4: Estado emocional negativo persistente (miedo, horror, ira, culpa, vergüenza). Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_11</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_11</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item12">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD5:DecreasedInterest"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 12 – Criterion D5: Markedly diminished interest or participation in significant activities. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 12 – Criterio D5: Disminución marcada del interés o participación en actividades. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_12</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_12</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item13">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD6:FeelingDetached"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 13 – Criterion D6: Feelings of detachment or estrangement from others. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 13 – Criterio D6: Sentimientos de desapego o extrañamiento de los demás. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_13</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_13</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item14">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD7:InabilityToExperiencePositiveEmotions"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 14 – Criterion D7: Persistent inability to experience positive emotions. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 14 – Criterio D7: Incapacidad persistente de experimentar emociones positivas. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_14</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_14</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item15">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE1:IrritabilityOrAnger"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 15 – Criterion E1: Irritable behavior and angry outbursts. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 15 – Criterio E1: Comportamiento irritable y arrebatos de ira. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_15</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_15</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item16">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE2:RecklessOrSelfDestructiveBehavior"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 16 – Criterion E2: Reckless or self-destructive behavior. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 16 – Criterio E2: Comportamiento imprudente o autodestructivo. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_16</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_16</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item17">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE3:Hypervigilance"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 17 – Criterion E3: Hypervigilance. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 17 – Criterio E3: Hipervigilancia. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_17</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_17</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item18">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE4:ExaggeratedStartleResponse"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 18 – Criterion E4: Exaggerated startle response. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 18 – Criterio E4: Respuesta exagerada de sobresalto. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_18</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_18</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item19">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE5:ConcentrationDifficulties"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 19 – Criterion E5: Problems with concentration. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 19 – Criterio E5: Problemas de concentración. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_19</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_19</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item2">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB2:DistressingDreams"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 2 – Criterion B2: Recurrent distressing dreams related to the traumatic event. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 2 – Criterio B2: Sueños angustiosos recurrentes relacionados al evento traumático. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_2</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_2</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item20">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE6:SleepDisturbances"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 20 – Criterion E6: Sleep disturbance. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 20 – Criterio E6: Alteración del sueño. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_20</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_20</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item21">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 21 – Dissociative subtype specifier: Depersonalization. Persistent or recurrent experiences of feeling detached from one's own mind or body. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 21 – Especificador subtipo disociativo: Despersonalización. Experiencias persistentes o recurrentes de sentirse desapegado de la propia mente o cuerpo. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_21</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_21</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item22">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 22 – Dissociative subtype specifier: Derealization. Persistent or recurrent experiences of unreality of surroundings. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 22 – Especificador subtipo disociativo: Desrealización. Experiencias persistentes o recurrentes de irrealidad del entorno. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_22</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_22</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item23">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 23 – Criterion F: Duration. The disturbance (Criteria B, C, D, E) lasts more than 1 month. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 23 – Criterio F: Duración. La alteración (B, C, D, E) dura más de 1 mes. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_23</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_23</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item24">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 24 – Criterion F: Onset delay specifier. Symptoms onset ≥6 months after the traumatic event. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 24 – Criterio F: Especificador inicio demorado. Los síntomas inician ≥6 meses después del evento traumático. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_24</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_24</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item25">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 25 – Criterion G: Subjective distress. The disturbance causes clinically significant distress. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 25 – Criterio G: Malestar subjetivo. La alteración causa malestar clínicamente significativo. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_25</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_25</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item26">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 26 – Criterion G: Social/occupational functioning impairment. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 26 – Criterio G: Deterioro en funcionamiento social/laboral. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_26</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_26</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item27">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 27 – Criterion G: Relationship functioning impairment. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 27 – Criterio G: Deterioro en funcionamiento relacional. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_27</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_27</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item28">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 28 – Criterion G: Other important area of functioning impairment. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 28 – Criterio G: Deterioro en otras áreas importantes de funcionamiento. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_28</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_28</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item29">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 29 – Response validity. Clinician assessment of interview validity. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 29 – Validez de respuesta. Evaluación clínica de la validez de la entrevista. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_29</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_29</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item3">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB3:DissociativeReactions"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 3 – Criterion B3: Dissociative reactions (flashbacks). Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 3 – Criterio B3: Reacciones disociativas (flashbacks). Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_3</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_3</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item30">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 30 – Overall PTSD severity rating by clinician (0=absent to 4=extreme). Integrates all symptom domains.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 30 – Puntuación global de severidad del TEPT por el clínico (0=ausente a 4=extremo). Integra todos los dominios.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_30</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_30</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item4">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB4:IntenseDistressAtStimuli"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 4 – Criterion B4: Intense or prolonged psychological distress at exposure to cues. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 4 – Criterio B4: Malestar psicológico intenso o prolongado ante estímulos relacionados. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_4</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_4</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item5">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB5:PhysiologicalReactions"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 5 – Criterion B5: Marked physiological reactions to internal or external cues. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 5 – Criterio B5: Reacciones fisiológicas marcadas ante estímulos internos o externos. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_5</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_5</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item6">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionC1:AvoidanceOfThoughts"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 6 – Criterion C1: Avoidance of distressing memories, thoughts, or feelings. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 6 – Criterio C1: Evitación de recuerdos, pensamientos o sentimientos angustiosos. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_6</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_6</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item7">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionC2:AvoidanceOfExternalReminders"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 7 – Criterion C2: Avoidance of external reminders (people, places, activities). Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 7 – Criterio C2: Evitación de recordatorios externos (personas, lugares, actividades). Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_7</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_7</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item8">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD1:MemoryImpairment"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 8 – Criterion D1: Inability to remember important aspects of the traumatic event. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 8 – Criterio D1: Incapacidad para recordar aspectos importantes del evento traumático. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_8</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_8</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_Item9">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD2:NegativeBeliefsAboutSelfOrWorld"/>
  <rdfs:comment xml:lang="en">CAPS-5 Item 9 – Criterion D2: Persistent and exaggerated negative beliefs about oneself, others, or the world. Score 0-4.</rdfs:comment>
  <rdfs:comment xml:lang="es">CAPS-5 Ítem 9 – Criterio D2: Creencias negativas persistentes y exageradas sobre uno mismo, los demás o el mundo. Puntaje 0-4.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_item_9</rdfs:label>
  <rdfs:label xml:lang="es">caps_item_9</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#CAPS_totalScore">
  <rdfs:subPropertyOf rdf:resource="#CAPSProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Clinician_Administered_PTSD_Scale_(CAPS)"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">Sum of CAPS-5 items 1-20 (core PTSD symptoms). Range 0-80. Threshold for probable PTSD: ≥31 (high sensitivity and specificity). Diagnostic rule: score ≥31 AND at least 1 intrusion item (1-5) ≥2, 1 avoidance item (6-7) ≥2, and 2 items from Criterion D or E (8-20) ≥2.</rdfs:comment>
  <rdfs:comment xml:lang="es">Suma de los ítems CAPS-5 del 1 al 20 (síntomas nucleares del TEPT). Rango 0-80. Umbral para TEPT probable: ≥31. Regla diagnóstica: puntaje ≥31 Y al menos 1 ítem de intrusión (1-5) ≥2, 1 ítem de evitación (6-7) ≥2, y 2 ítems de los criterios D o E (8-20) ≥2.</rdfs:comment>
  <rdfs:label xml:lang="en">caps_total_score</rdfs:label>
  <rdfs:label xml:lang="es">puntaje_total_caps</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#EEGFeatureExtracted">
  <rdfs:subPropertyOf rdf:resource="#EEGProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdfs:comment xml:lang="es">Característica extraída de la señal obtenida a partir de un canal del EEG</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of EEG Feature Extracted</rdfs:comment>
  <rdfs:label xml:lang="es">características_extraida_eeg</rdfs:label>
  <rdfs:label xml:lang="en">eeg_feature_extracted</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#EEGProperty">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="#EEG_Recording"/>
  <rdfs:comment xml:lang="es">Definición de EEG Property</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of EEG Property</rdfs:comment>
  <rdfs:label xml:lang="en">eeg_property</rdfs:label>
  <rdfs:label xml:lang="es">propiedad_eeg</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#EventProperty">
  <rdfs:domain rdf:resource="#Event"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment xml:lang="es">Indica si un evento posee características específicas relevantes para su clasificación dentro de la ontología. Esta propiedad actúa como un indicador booleano general para los atributos asociados al evento.</rdfs:comment>
  <rdfs:comment xml:lang="en">Indicates whether a given event possesses specific characteristics relevant to its classification within the ontology. This property serves as a general Boolean indicator for event-related attributes.</rdfs:comment>
  <rdfs:label xml:lang="en">event_property</rdfs:label>
  <rdfs:label xml:lang="es">propiedad_evento</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#P1Maximum">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Maximum value of the P1 component.</rdfs:comment>
  <rdfs:comment xml:lang="es">Valor máximo del componente P1.</rdfs:comment>
  <rdfs:label xml:lang="en">p1maximum</rdfs:label>
  <rdfs:label xml:lang="es">p1maximum</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#P1Mean">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Mean value of the P1 component.</rdfs:comment>
  <rdfs:comment xml:lang="es">Valor medio del componente P1.</rdfs:comment>
  <rdfs:label xml:lang="en">p1mean</rdfs:label>
  <rdfs:label xml:lang="es">p1mean</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#P1Power">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Potencia del componente P1.</rdfs:comment>
  <rdfs:comment xml:lang="en">Power of the P1 component.</rdfs:comment>
  <rdfs:label xml:lang="en">p1power</rdfs:label>
  <rdfs:label xml:lang="es">p1power</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PC-PTSDProperty">
  <rdfs:domain rdf:resource="#PrimaryCarePTSD_Screen_PC-PTSD-5"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  <rdfs:comment xml:lang="en">Property representing a response in the Primary Care PTSD Screen for DSM-5 (PC-PTSD-5).</rdfs:comment>
  <rdfs:comment xml:lang="es">Propiedad que representa una respuesta del cuestionario PC-PTSD-5 aplicado en la atención primaria.</rdfs:comment>
  <rdfs:label xml:lang="en">pc-ptsd_property</rdfs:label>
  <rdfs:label xml:lang="es">propiedad_pc-ptsd</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PC-PTSD_Item1">
  <rdfs:subPropertyOf rdf:resource="#PC-PTSDProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Have you had any experience that repeatedly made you relive distressing memories of the traumatic event?</rdfs:comment>
  <rdfs:comment xml:lang="es">¿Ha tenido alguna experiencia que le haya hecho revivir repetidamente recuerdos angustiosos del evento traumático?</rdfs:comment>
  <rdfs:label xml:lang="en">pc-ptsd_item1</rdfs:label>
  <rdfs:label xml:lang="es">ítem_1_pc-ptsd</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PC-PTSD_Item2">
  <rdfs:subPropertyOf rdf:resource="#PC-PTSDProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Have you tried to avoid situations or activities that reminded you of the traumatic event?</rdfs:comment>
  <rdfs:comment xml:lang="es">¿Ha tratado de evitar situaciones o actividades que le recordaran el evento traumático?</rdfs:comment>
  <rdfs:label xml:lang="en">pc-ptsd_item2</rdfs:label>
  <rdfs:label xml:lang="es">ítem_2_pc-ptsd</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PC-PTSD_Item3">
  <rdfs:subPropertyOf rdf:resource="#PC-PTSDProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Have you been constantly on guard or watchful since the event?</rdfs:comment>
  <rdfs:comment xml:lang="es">¿Ha estado constantemente en estado de alerta o en guardia desde el evento?</rdfs:comment>
  <rdfs:label xml:lang="en">pc-ptsd_item3</rdfs:label>
  <rdfs:label xml:lang="es">ítem_3_pc-ptsd</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PC-PTSD_Item4">
  <rdfs:subPropertyOf rdf:resource="#PC-PTSDProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Have you felt numb or detached from others, activities, or your surroundings?</rdfs:comment>
  <rdfs:comment xml:lang="es">¿Se ha sentido adormecido o desconectado de los demás, de las actividades o de su entorno?</rdfs:comment>
  <rdfs:label xml:lang="en">pc-ptsd_item4</rdfs:label>
  <rdfs:label xml:lang="es">ítem_4_pc-ptsd</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PC-PTSD_Item5">
  <rdfs:subPropertyOf rdf:resource="#PC-PTSDProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Have you experienced feelings of guilt or shame related to the event?</rdfs:comment>
  <rdfs:comment xml:lang="es">¿Ha experimentado sentimientos de culpa o vergüenza relacionados con el evento?</rdfs:comment>
  <rdfs:label xml:lang="en">pc-ptsd_item_5</rdfs:label>
  <rdfs:label xml:lang="es">ítem_5_pc-ptsd</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PC-PTSD_ItemtotalScore">
  <rdfs:subPropertyOf rdf:resource="#PC-PTSDProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Definición de PC-PTSD Itemtotal Score</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of PC-PTSD Itemtotal Score</rdfs:comment>
  <rdfs:label xml:lang="en">pc-ptsd_itemtotal_score</rdfs:label>
  <rdfs:label xml:lang="es">pc-ptsd_itemtotal_score</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL5Property">
  <rdfs:subPropertyOf rdf:resource="#PCLProperty"/>
  <rdfs:domain rdf:resource="#PTSD_Checklist_PCL5"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">Parent property for all PCL-5 (PTSD Checklist for DSM-5) item responses. Domain restricted to PTSD_Checklist_PCL5 to prevent PCL-C (DSM-IV) items from being inadvertently linked to DSM-5 criteria.</rdfs:comment>
  <rdfs:comment xml:lang="es">Propiedad padre de todos los ítems del PCL-5 (PTSD Checklist para DSM-5). Dominio restringido a PTSD_Checklist_PCL5 para impedir que los ítems del PCL-C (DSM-IV) se vinculen inadvertidamente con los criterios del DSM-5.</rdfs:comment>
  <rdfs:label xml:lang="en">pcl5_property</rdfs:label>
  <rdfs:label xml:lang="es">propiedad_pcl5</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCLProperty">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="#PTSD_Checklist_PCL"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">Numeric response property for individual items of the PTSD Checklist (PCL). Values represent the severity rating for each item as administered in the PCL-5 (20 items) or PCL-C (17 items) instruments.</rdfs:comment>
  <rdfs:comment xml:lang="es">Propiedad numérica para las respuestas de los ítems del PTSD Checklist (PCL). Los valores representan la puntuación de severidad para cada ítem tal como se administran en los instrumentos PCL-5 (20 ítems) o PCL-C (17 ítems).</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_property</rdfs:label>
  <rdfs:label xml:lang="es">propiedad_pcl</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item1">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB1:IntrusiveMemories"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 1 → DSM-5 B1: Intrusive memories</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 1: Repeated, disturbing, and unwanted memories of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 1 → DSM-5 B1: Recuerdos intrusivos</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 1: Recuerdos repetidos, perturbadores e indeseados del suceso estresante?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 1 (DSM-IV based): Repeated, disturbing, or unwanted memories of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 1: Recuerdos repetidos, perturbadores o no deseados del suceso estresante?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_1</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_1</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item10">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD3:DistortedCognitionsAboutCause"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 10 → DSM-5 D3: Distorted blame of self or others</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 10: Blaming yourself or someone else for the stressful experience or what happened after it?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 10 → DSM-5 D3: Culpa distorsionada hacia uno mismo u otros</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 10: Culparse a sí mismo u a otra persona por el suceso estresante o por lo que ocurrió después?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 10: Loss of interest in activities that you used to enjoy?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 10: Pérdida de interés en actividades que antes disfrutaba?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_10</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_10</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item11">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD4:PersistentNegativeEmotions"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 11 → DSM-5 D4: Persistent negative emotional state</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 11: Having strong negative feelings such as fear, horror, anger, guilt, or shame?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 11 → DSM-5 D4: Estado emocional negativo persistente</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 11: Tener sentimientos negativos intensos como miedo, horror, ira, culpa o vergüenza?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 11: Feeling detached or estranged from others?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 11: Sentirse desconectado o distanciado de los demás?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_11</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_11</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item12">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD5:DecreasedInterest"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 12 → DSM-5 D5: Markedly diminished interest in activities</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 12: Loss of interest in activities that you used to enjoy?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 12 → DSM-5 D5: Disminución marcada del interés en actividades</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 12: Pérdida de interés en actividades que antes disfrutaba?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 12: Feeling as if your future will somehow be cut short?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 12: Sentir que su futuro de alguna manera será truncado?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_12</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_12</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item13">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD6:FeelingDetached"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 13 → DSM-5 D6: Feelings of detachment from others</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 13: Feeling distant or cut off from other people?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 13 → DSM-5 D6: Sentimientos de desapego de los demás</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 13: Sentirse distante o desconectado de otras personas?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 13: Trouble falling or staying asleep?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 13: Dificultad para conciliar o mantener el sueño?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_13</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_13</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item14">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD7:InabilityToExperiencePositiveEmotions"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 14 → DSM-5 D7: Inability to experience positive emotions</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 14: Trouble experiencing positive feelings (for example, being unable to feel happiness or have loving feelings for people close to you)?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 14 → DSM-5 D7: Incapacidad de experimentar emociones positivas</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 14: Dificultad para experimentar emociones positivas (p. ej., incapacidad para sentir felicidad o mantener sentimientos afectuosos por personas cercanas)?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 14: Feeling irritable or having angry outbursts?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 14: Sentirse irritable o tener estallidos de ira?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_14</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_14</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item15">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE1:IrritabilityOrAnger"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 15 → DSM-5 E1: Irritability or angry outbursts</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 15: Irritable behavior, angry outbursts, or acting aggressively?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 15 → DSM-5 E1: Irritabilidad o arrebatos de ira</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 15: Comportamiento irritable, estallidos de ira o conducta agresiva?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 15: Having difficulty concentrating?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 15: Dificultad para concentrarse?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_15</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_15</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item16">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE2:RecklessOrSelfDestructiveBehavior"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 16 → DSM-5 E2: Reckless or self-destructive behavior</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 16: Taking too many risks or doing things that could cause you harm (reckless or self-destructive behavior)?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 16 → DSM-5 E2: Conducta imprudente o autodestructiva</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 16: Tomar demasiados riesgos o hacer cosas que podrían causarle daño (conducta imprudente o autodestructiva)?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 16: Being 'super-alert', watchful, or on guard?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 16: Estar 'súper alerta', vigilante o en guardia?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_16</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_16</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item17">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE5:ConcentrationDifficulties"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 17 → DSM-5 E5: Concentration difficulties</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 17: Difficulty concentrating?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 17 → DSM-5 E5: Dificultades de concentración</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 17: Dificultad para concentrarse?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 17: Feeling jumpy or easily startled?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 17: Sentirse sobresaltado o fácilmente asustado?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_17</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_17</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item18">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE6:SleepDisturbances"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 18 → DSM-5 E6: Sleep disturbances</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 18: Trouble falling or staying asleep?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 18 → DSM-5 E6: Alteraciones del sueño</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 18: Dificultad para conciliar o mantener el sueño?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C: no equivalent item (PCL-C contains 17 items only).</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C: no existe ítem equivalente (PCL-C contiene solo 17 ítems).</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_18</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_18</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item19">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE5:ConcentrationDifficulties"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 19 → DSM-5 E5: Concentration problems</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 19: Problems with concentration?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 19 → DSM-5 E5: Problemas de concentración</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 19: Problemas para concentrarse?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C: no equivalent item (PCL-C contains 17 items only).</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C: no existe ítem equivalente (PCL-C contiene solo 17 ítems).</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_19</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_19</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item2">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB2:DistressingDreams"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 2 → DSM-5 B2: Distressing dreams</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 2: Repeated, disturbing dreams of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 2 → DSM-5 B2: Sueños angustiosos</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 2: Sueños repetidos y perturbadores relacionados con el suceso estresante?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 2: Repeated distressing dreams of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 2: Sueños angustiantes repetidos sobre el suceso estresante?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_2</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_2</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item20">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionE4:ExaggeratedStartleResponse"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 20 → DSM-5 E4: Exaggerated startle response</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 20: Problems with sleep (trouble falling or staying asleep) or concentrating?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 20 → DSM-5 E4: Respuesta exagerada de sobresalto</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 20: Problemas con el sueño (dificultad para conciliar o mantener el sueño) o la concentración?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C: no equivalent item (PCL-C contains 17 items only).</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C: no existe ítem equivalente (PCL-C contiene solo 17 ítems).</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_20</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_20</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item3">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB3:DissociativeReactions"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 3 → DSM-5 B3: Dissociative reactions (flashbacks)</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 3: Suddenly acting or feeling as if the stressful experience were happening again (as if you were reliving it)?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 3 → DSM-5 B3: Reacciones disociativas (flashbacks)</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 3: Actuar o sentirse de repente como si el suceso estresante estuviera ocurriendo de nuevo (como si lo reviviera)?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 3: Suddenly acting or feeling as if the stressful experience were happening again?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 3: Actuar o sentirse de forma repentina como si el suceso estresante estuviera ocurriendo nuevamente?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_3</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_3</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item4">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB4:IntenseDistressAtStimuli"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 4 → DSM-5 B4: Intense distress at cues</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 4: Feeling very upset when something reminded you of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 4 → DSM-5 B4: Malestar intenso ante estímulos</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 4: Sentirse muy angustiado cuando algo le recuerda el suceso estresante?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 4: Feeling very upset when reminded of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 4: Sentirse muy alterado cuando se le recuerda el suceso estresante?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_4</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_4</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item5">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionB5:PhysiologicalReactions"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 5 → DSM-5 B5: Physiological reactions to cues</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 5: Having strong physical reactions when something reminded you of the stressful experience (e.g., heart pounding, trouble breathing, sweating)?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 5 → DSM-5 B5: Reacciones fisiológicas ante estímulos</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 5: Tener reacciones físicas intensas cuando algo le recuerda el suceso estresante (p. ej., palpitaciones, dificultad para respirar, sudoración)?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 5: Physical reactions when reminded of the stressful experience (e.g., sweating, heart racing)?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 5: Reacciones físicas al recordar el suceso estresante (p. ej., sudoración, palpitaciones)?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_5</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_5</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item6">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionC1:AvoidanceOfThoughts"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 6 → DSM-5 C1: Avoidance of internal reminders</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 6: Avoiding memories, thoughts, or feelings related to the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 6 → DSM-5 C1: Evitación de recordatorios internos</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 6: Evitar recuerdos, pensamientos o sentimientos relacionados con el suceso estresante?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 6: Avoiding thoughts, feelings or conversations associated with the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 6: Evitar pensamientos, sentimientos o conversaciones asociados con el suceso estresante?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_6</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_6</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item7">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionC2:AvoidanceOfExternalReminders"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 7 → DSM-5 C2: Avoidance of external reminders</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 7: Avoiding external reminders of the stressful experience (e.g., people, places, conversations, activities, objects, or situations)?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 7 → DSM-5 C2: Evitación de recordatorios externos</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 7: Evitar recordatorios externos del suceso estresante (p. ej., personas, lugares, conversaciones, actividades, objetos o situaciones)?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 7: Avoiding places, people or activities that remind you of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 7: Evitar lugares, personas o actividades que le recuerden el suceso estresante?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_7</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_7</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item8">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD1:MemoryImpairment"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 8 → DSM-5 D1: Trauma-related memory impairment</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 8: Trouble remembering important parts of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 8 → DSM-5 D1: Deterioro de memoria relacionado al trauma</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 8: Dificultad para recordar partes importantes del suceso estresante?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 8: Trouble remembering important parts of the stressful experience?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 8: Problemas para recordar partes importantes del suceso estresante?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_8</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_8</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_Item9">
  <rdfs:subPropertyOf rdf:resource="#PCL5Property"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <evaluatesSymptomCluster rdf:resource="#DSM5_CriterionD2:NegativeBeliefsAboutSelfOrWorld"/>
  <rdfs:comment xml:lang="en">PCL-5 Item 9 → DSM-5 D2: Negative beliefs about self or world</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-5 item 9: Having strong negative beliefs about yourself, other people, or the world (for example, 'I am bad', 'No one can be trusted', 'The world is completely dangerous')?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 Ítem 9 → DSM-5 D2: Creencias negativas sobre uno mismo o el mundo</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-5 ítem 9: Mantener creencias negativas intensas sobre usted mismo, otras personas o el mundo (por ejemplo, 'Soy malo', 'No se puede confiar en nadie', 'El mundo es completamente peligroso')?</rdfs:comment>
  <rdfs:comment xml:lang="en">PCL-C item 9: Blaming yourself or someone else for the stressful experience or what happened after it?</rdfs:comment>
  <rdfs:comment xml:lang="es">PCL-C ítem 9: ¿Se culpa a sí mismo u a otra persona por el suceso estresante o por lo ocurrido después?</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_item_9</rdfs:label>
  <rdfs:label xml:lang="es">pcl_item_9</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PCL_totalScore">
  <rdfs:subPropertyOf rdf:resource="#PCLProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="en">Aggregated total severity score for the PCL instrument. for PCL-5 sum of items 1–20 (range 0–80 if 0–4 scoring). for PCL-C sum of items 1–17 (range depends on scoring protocol used: e.g., 17–85 if 1–5 scoring).</rdfs:comment>
  <rdfs:comment xml:lang="es">Puntuación total agregada de severidad para el instrumento PCL. Para PCL-5, suma de los ítems 1–20 (rango 0–80 si se usa escala 0–4). Para PCL-C, suma de los ítems 1–17 (rango según protocolo, p. ej. 17–85 si escala 1–5).</rdfs:comment>
  <rdfs:label xml:lang="en">pcl_total_score</rdfs:label>
  <rdfs:label xml:lang="es">pcl_total_score</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#RSSQ">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Raíz de la suma de cuadrados de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Root sum square of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">rssq</rdfs:label>
  <rdfs:label xml:lang="es">rssq</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#SSI">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Integral cuadrada simple de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Simple squared integral of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">ssi</rdfs:label>
  <rdfs:label xml:lang="es">ssi</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#SSI2Power">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Potencia del segundo índice SSI de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Power of the second SSI index of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">ssi2power</rdfs:label>
  <rdfs:label xml:lang="es">ssi2power</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#SymptomProperty">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="#Symptom"/>
  <rdfs:comment xml:lang="en">General data property used to describe attributes or measurable aspects of a symptom observed in a patient.</rdfs:comment>
  <rdfs:comment xml:lang="es">Propiedad de dato general utilizada para describir atributos o aspectos medibles de un síntoma observado en un paciente.</rdfs:comment>
  <rdfs:label xml:lang="es">propiedad_síntoma</rdfs:label>
  <rdfs:label xml:lang="en">symptom_property</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#TraumaticEventProperty">
  <rdfs:subPropertyOf rdf:resource="#EventProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Event"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment xml:lang="es">Indica si el evento califica como traumático de acuerdo con los criterios diagnósticos (por ejemplo, DSM-5, ICD-11). Un valor “true” indica evento traumático, mientras que “false” indica evento no traumático.</rdfs:comment>
  <rdfs:comment xml:lang="en">Indicates whether the event qualifies as traumatic according to diagnostic criteria (e.g., DSM-5, ICD-11). a value of “true” denotes a traumatic event, while “false” denotes a non-traumatic event.</rdfs:comment>
  <rdfs:label xml:lang="es">propiedad_evento_traumático</rdfs:label>
  <rdfs:label xml:lang="en">traumatic_event_property</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#areaUnderCurve">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Area under the EEG signal curve.</rdfs:comment>
  <rdfs:comment xml:lang="es">Área bajo la curva de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">area_under_curve</rdfs:label>
  <rdfs:label xml:lang="es">area_under_curve</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#asymmetryIndexDecay">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Asymmetry index by decay in EEG.</rdfs:comment>
  <rdfs:comment xml:lang="es">Índice de asimetría por decaimiento en EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">asymmetry_index_decay</rdfs:label>
  <rdfs:label xml:lang="es">asymmetry_index_decay</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#attributableEffectsSubstance">
  <rdfs:subPropertyOf rdf:resource="#SymptomProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Symptom"/>
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment xml:lang="es">Determina si la alteración es atribuible a efectos fisiológicos de una sustancia u otra condición médica (criterio H del DSM-5)</rdfs:comment>
  <rdfs:comment xml:lang="en">To determine if the disturbance is attributable to the physiological effects of a substance or another medical condition (Criterion H from DSM-5)</rdfs:comment>
  <rdfs:label xml:lang="en">attributable_effects_substance</rdfs:label>
  <rdfs:label xml:lang="es">attributable_effects_substance</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#channel">
  <rdfs:subPropertyOf rdf:resource="#EEGProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment xml:lang="es">Definición de channel</rdfs:comment>
  <rdfs:comment xml:lang="en">Definition of channel</rdfs:comment>
  <rdfs:label xml:lang="es">canal</rdfs:label>
  <rdfs:label xml:lang="en">channel</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#correlationEnergy13">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Correlation energy at one-third of the EEG signal.</rdfs:comment>
  <rdfs:comment xml:lang="es">Energía de la correlación entre 1/3 de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">correlation_energy13</rdfs:label>
  <rdfs:label xml:lang="es">correlation_energy13</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#correlationEnergy23">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Correlation energy at two-thirds of the EEG signal.</rdfs:comment>
  <rdfs:comment xml:lang="es">Energía de la correlación entre 2/3 de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">correlation_energy23</rdfs:label>
  <rdfs:label xml:lang="es">correlation_energy23</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#correlationPeakCount">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Number of peaks in EEG signal correlation.</rdfs:comment>
  <rdfs:comment xml:lang="es">Número de picos en la correlación de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">correlation_peak_count</rdfs:label>
  <rdfs:label xml:lang="es">correlation_peak_count</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#covariance">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Covariance of the EEG signal.</rdfs:comment>
  <rdfs:comment xml:lang="es">Covarianza de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">covariance</rdfs:label>
  <rdfs:label xml:lang="es">covariance</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#description">
  <rdfs:subPropertyOf rdf:resource="#SymptomProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment xml:lang="es">Proporciona una descripción textual o narrativa que detalla el síntoma o alteración observada, incluye la severidad.</rdfs:comment>
  <rdfs:comment xml:lang="en">Provides a textual description or narrative detailing the observed symptom or disturbance. Include severity.</rdfs:comment>
  <rdfs:label xml:lang="es">descripción</rdfs:label>
  <rdfs:label xml:lang="en">description</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#disturbanceClinicallySignificant">
  <rdfs:subPropertyOf rdf:resource="#SymptomProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Symptom"/>
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:comment xml:lang="en"></rdfs:comment>
  <rdfs:comment xml:lang="es">Indica si la alteración causa malestar clínicamente significativo o deterioro en las áreas sociales, laborales u otras áreas importantes del funcionamiento (criterio G del DSM-5; criterio 6 del ICD-11).</rdfs:comment>
  <rdfs:comment xml:lang="en">Indicates whether the disturbance causes clinically significant distress or impairment in social, occupational, or other important areas of functioning (Criterion G of DSM-5; Criterion 6 of ICD-11).</rdfs:comment>
  <rdfs:label xml:lang="en">disturbance_clinically_significant</rdfs:label>
  <rdfs:label xml:lang="es">malestar_clínicamente_significativo</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#duration">
  <rdfs:subPropertyOf rdf:resource="#SymptomProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Symptom"/>
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:comment xml:lang="es">Especifica la duración (en meses) de la alteración. Según el criterio F del DSM-5 y el criterio 5 del ICD-11, la duración debe superar un mes para apoyar un diagnóstico de TEPT.</rdfs:comment>
  <rdfs:comment xml:lang="en">Specifies the duration (in months) of the disturbance. According to DSM-5 Criterion F and ICD-11 Criterion 5, the duration must exceed one month to support a PTSD diagnosis.</rdfs:comment>
  <rdfs:label xml:lang="es">duración</rdfs:label>
  <rdfs:label xml:lang="en">duration</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eegVariance">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">EEG-specific signal variance.</rdfs:comment>
  <rdfs:comment xml:lang="es">Varianza de la señal EEG calculada específicamente para análisis EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">eeg_variance</rdfs:label>
  <rdfs:label xml:lang="es">eeg_variance</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#envelopeAsymmetry">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Asimetría de la envolvente de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Asymmetry of the EEG signal envelope.</rdfs:comment>
  <rdfs:label xml:lang="en">envelope_asymmetry</rdfs:label>
  <rdfs:label xml:lang="es">envelope_asymmetry</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#envelopeKurtosis">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Curtosis de la envolvente de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Kurtosis of the EEG signal envelope.</rdfs:comment>
  <rdfs:label xml:lang="en">envelope_kurtosis</rdfs:label>
  <rdfs:label xml:lang="es">envelope_kurtosis</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fftMaximum">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Maximum value of the EEG FFT spectrum.</rdfs:comment>
  <rdfs:comment xml:lang="es">Valor máximo del espectro FFT de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">fft_maximum</rdfs:label>
  <rdfs:label xml:lang="es">fft_maximum</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fftMean">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Mean value of the EEG FFT spectrum.</rdfs:comment>
  <rdfs:comment xml:lang="es">Valor medio del espectro FFT de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">fft_mean</rdfs:label>
  <rdfs:label xml:lang="es">fft_mean</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fftMedian">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Median of the EEG FFT spectrum.</rdfs:comment>
  <rdfs:comment xml:lang="es">Mediana del espectro FFT de la señal EEG.</rdfs:comment>
  <rdfs:label xml:lang="en">fft_median</rdfs:label>
  <rdfs:label xml:lang="es">fft_median</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fftPeakFrequency">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Frecuencia de pico en el espectro FFT.</rdfs:comment>
  <rdfs:comment xml:lang="en">Peak frequency in the FFT spectrum.</rdfs:comment>
  <rdfs:label xml:lang="en">fft_peak_frequency</rdfs:label>
  <rdfs:label xml:lang="es">fft_peak_frequency</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#fftVariance">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="en">Variance of the FFT spectrum.</rdfs:comment>
  <rdfs:comment xml:lang="es">Varianza del espectro FFT.</rdfs:comment>
  <rdfs:label xml:lang="en">fft_variance</rdfs:label>
  <rdfs:label xml:lang="es">fft_variance</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#frecuency">
  <rdfs:subPropertyOf rdf:resource="#SymptomProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment xml:lang="es">Indica la frecuencia o tasa de ocurrencia de un síntoma durante un período específico de observación.</rdfs:comment>
  <rdfs:comment xml:lang="en">Indicates the frequency or rate of occurrence of a symptom within a specific observation period.</rdfs:comment>
  <rdfs:label xml:lang="es">frecuencia</rdfs:label>
  <rdfs:label xml:lang="en">frequency</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#histogramEntropy">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Entropía del histograma de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Histogram entropy of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">histogram_entropy</rdfs:label>
  <rdfs:label xml:lang="es">histogram_entropy</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#integralRatio">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Cociente entre integrales específicas de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Ratio between specific EEG signal integrals.</rdfs:comment>
  <rdfs:label xml:lang="en">integral_ratio</rdfs:label>
  <rdfs:label xml:lang="es">integral_ratio</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#kurtosis">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Curtosis de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Kurtosis of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">kurtosis</rdfs:label>
  <rdfs:label xml:lang="es">kurtosis</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#logEnergyEntropy">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Entropía de energía logarítmica de la señal EEG.</rdfs:comment>
  <rdfs:comment xml:lang="en">Logarithmic energy entropy of the EEG signal.</rdfs:comment>
  <rdfs:label xml:lang="en">log_energy_entropy</rdfs:label>
  <rdfs:label xml:lang="es">log_energy_entropy</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#maxToMeanRatio">
  <rdfs:subPropertyOf rdf:resource="#EEGFeatureExtracted"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment xml:lang="es">Cociente entre máximo y media del FFT.</rdfs:comment>
